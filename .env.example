PORT=8099
# Where db.json lives.
#   Docker      → /app/data   (matches the compose volume; leave the line below as is)
#   Bare metal  → ./data      (comment out the Docker line and uncomment the other)
# Getting this wrong on bare metal fails at startup with EACCES trying to mkdir /app.
DATA_DIR=/app/data
#DATA_DIR=./data

# ── eBooks & authors → Chaptarr ───────────────────────────────────────────
# Chaptarr listens on port 8789 by default. Find the API key in its UI under
# Settings → General → Security (or in its config.xml as <ApiKey>).
# Chaptarr can hold audiobooks as well as eBooks and types its quality profiles,
# metadata profiles and root folders per format. BookSeerr drives only its EBOOK
# side (audiobooks go to Listenarr below), so the request form only ever offers the
# eBook-typed profiles and folders — an eBook can't be filed against an audiobook one.
CHAPTARR_URL=http://host.docker.internal:8789
CHAPTARR_API_KEY=your_chaptarr_api_key_here
# Upgrading from the old Bookshelf/Readarr integration? BOOKSHELF_URL /
# BOOKSHELF_API_KEY (and READARR_*) are still read as a fallback, so an existing
# .env keeps working until you switch it over to the names above.

# ── Audiobooks → Listenarr ────────────────────────────────────────────────
# Listenarr listens on port 4545 by default. Find/rotate the API key in its UI
# under Settings → Security. Listenarr identifies a title by its Audible ASIN and
# files it under its own root folder, so a request only picks a quality profile.
# (Audible is also the SEARCH source for audiobooks — see AUDIBLE_* below.)
LISTENARR_URL=http://host.docker.internal:4545
LISTENARR_API_KEY=your_listenarr_api_key_here

# ── Audible catalog (Discover: recent + upcoming audiobooks) ──────────────
# US marketplace = api.audible.com. For other regions point AUDIBLE_BASE at the
# matching host (e.g. https://api.audible.co.uk, https://api.audible.de).
AUDIBLE_BASE=https://api.audible.com
AUDIBLE_REGION=us
# Optional: limit Discover to one Audible category id (leave blank for all).
AUDIBLE_CATEGORY_ID=

# ── Upstream call tuning ───────────────────────────────────────────────────
# Retries for transient upstream failures (503/429/timeouts) on GET only — writes
# are never retried. Google Books in particular likes to 503 the first call.
UPSTREAM_RETRIES=2
# How long the Discover rows (Google Books + Audible) are cached, in minutes.
# These lists change daily at most; caching keeps you inside the Google Books quota.
DISCOVER_TTL_MINUTES=30
# Ceiling on a single upstream response body, in bytes (default 16 MiB).
MAX_UPSTREAM_BYTES=16777216

# ── eBook metadata for Discover/Search (Google Books) ─────────────────────
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
# Host for the Google Books API. Only change this to point at a proxy or a mock.
#GOOGLE_BOOKS_BASE=https://www.googleapis.com/books/v1
# Open Library needs no key: eBook search and the classics row fall back to it when
# Google Books is down (it can 503 for days). Only change these for a proxy or a mock.
#OPENLIBRARY_BASE=https://openlibrary.org
#OPENLIBRARY_COVERS=https://covers.openlibrary.org

# ── Auth ───────────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=changeme
# Sign-in tokens are signed with this — use a long random value, NOT the default.
# Generate one with:  openssl rand -hex 32
# If you leave this blank (or as the placeholder), BookSeerr generates a random key
# on first run and saves it to DATA_DIR/.jwt_secret so the app is never signable
# with a value that ships in the source. Setting it here keeps it under your control.
JWT_SECRET=change_me_to_a_long_random_string
# How long a sign-in lasts (zeit/ms format: 30d, 12h, 90d). Sessions can be revoked
# server-side at any time, so this is a convenience knob rather than your only defence.
JWT_TTL=365d

# ── Brute-force protection ─────────────────────────────────────────────────
# Failures are counted against the ACCOUNT, so rotating source IPs doesn't help an
# attacker. A correct password clears the counter immediately.
LOGIN_MAX_FAILS=10
LOGIN_LOCK_MINUTES=15

# ── Reverse proxy ──────────────────────────────────────────────────────────
# How many proxies sit in front of BookSeerr. This decides which address the rate
# limiter treats as "the client".
#   1      → one reverse proxy (nginx / Traefik / Caddy). Default, matches compose.
#   2      → two hops, e.g. Cloudflare → nginx → BookSeerr
#   false  → BookSeerr is exposed directly; ignore X-Forwarded-For entirely.
# Setting this HIGHER than your real number of proxies lets a caller forge their IP
# by sending their own X-Forwarded-For header, so keep it accurate.
TRUST_PROXY=1

# ── Embedding & cross-origin access ────────────────────────────────────────
# Which sites may embed BookSeerr in an <iframe>. Space/comma separated.
# LEAVE BLANK AND ANY SITE CAN FRAME IT — set this if BookSeerr is reachable
# from outside your network. e.g. FRAME_ANCESTORS=https://hub.example.com
FRAME_ANCESTORS=
# Origins allowed to call the API cross-origin from a browser (comma separated,
# "*" for any). Blank disables CORS entirely — server-to-server callers and
# same-origin dashboards don't need it.
CORS_ORIGINS=
# How long to wait on Chaptarr/Listenarr/Audible before giving up, in ms.
UPSTREAM_TIMEOUT_MS=8000
# How long to wait when actually SENDING a request to a downloader. Kept separate
# (and longer) because Chaptarr can stall 20-30s at a stretch while it runs internal
# work, and giving up there loses the request rather than just a search result.
SEND_TIMEOUT_MS=30000
# How long to wait for Chaptarr's author and book LISTS (and its metadata lookups).
# On a big library these took 20-45s each live — far past UPSTREAM_TIMEOUT_MS — which
# made BookSeerr think authors already in Chaptarr weren't there. They're cached and
# refreshed in the background, so users rarely wait on one.
LIBRARY_TIMEOUT_MS=120000

# ── Container runtime user ─────────────────────────────────────────────────
# BookSeerr runs as a non-root user inside the container. These set which uid/gid
# it runs as and owns ./data with. Match them to the owner of your host ./data dir
# if it isn't 1000:1000 (the entrypoint chowns the dir to match either way).
PUID=1000
PGID=1000
